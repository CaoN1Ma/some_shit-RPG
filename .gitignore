# ============================================================
# Some Shit RPG 《粪坑RPG》 — .gitignore
# 原则：仓库里只保留"可运行 + 可开发"的最小集合。
# 凡是能由工具再生成的、属于本机环境的、属于密钥的，一律不提交。
# ============================================================

# ---------- 密钥与环境变量（红线：永不入库） ----------
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
secrets/

# ---------- 依赖目录（lockfile 提交，目录本身不提交） ----------
node_modules/
vendor/
bower_components/

# ---------- 构建产物（源码在仓库里，产物可再生） ----------
dist/
build/
out/
*.min.js
*.min.css
*.bundle.js
.cache/
.parcel-cache/
.vite/
.tsbuildinfo

# ---------- 测试与覆盖率输出 ----------
coverage/
.nyc_output/
*.lcov

# ---------- 日志与临时文件 ----------
*.log
logs/
tmp/
temp/
*.tmp
*.swp
*~

# ---------- 编辑器 / IDE（本机环境，与项目无关） ----------
.idea/
.vscode/
*.sublime-*
.history/

# ---------- 操作系统杂物 ----------
.DS_Store
Thumbs.db
desktop.ini

# ---------- 各语言缓存（本项目零构建，这些供未来 PR 参考） ----------
__pycache__/
*.pyc
.venv/
target/
bin/

# ---------- 架构图草稿与一次性脚本 ----------
docs/drafts/
scratch/
